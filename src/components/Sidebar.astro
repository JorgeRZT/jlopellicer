---
import { ui, path, otherLang, type Lang } from '../i18n';
interface Props { lang: Lang; alt: string }
const { lang, alt } = Astro.props;
const t = ui[lang];
const current = Astro.url.pathname;
const links = [
  { href: path(lang), label: t.nav.home, d: 'M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.6A8 8 0 1 1 21 12z' },
  { href: path(lang, 'apps'), label: t.nav.apps, d: 'M4 4h6.5v6.5H4zM13.5 4H20v6.5h-6.5zM4 13.5h6.5V20H4zM13.5 13.5H20V20h-6.5z' },
  { href: path(lang, 'blog'), label: t.nav.blog, d: 'M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17zM14 7l3 3' },
];
const active = (h: string) => (h === path(lang) ? current === h : current.startsWith(h));
const other = otherLang(lang);
---
<aside class="side">
  <a href={path(lang)} class="brand" aria-label="Jorge López Pellicer"><b>J</b><span>Jorge López<br />Pellicer</span></a>
  <nav aria-label="Principal">
    {links.map((l) => (
      <a href={l.href} class:list={{ on: active(l.href) }} aria-current={active(l.href) ? 'page' : undefined} >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={l.d} /></svg>
        <span>{l.label}</span>
      </a>
    ))}
  </nav>
  <a href={alt} class="item lang" hreflang={other} lang={other}><b>{other.toUpperCase()}</b><span>{t.switchTo}</span></a>
</aside>
<style>
  .side { flex: none; width: 208px; display: flex; flex-direction: column; gap: 20px; padding: 16px 12px; background: var(--surface); border-right: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 10px; padding: 0 6px; color: var(--ink); font-weight: 600; font-size: .85rem; line-height: 1.2; }
  .brand:hover { color: var(--ink); text-decoration: none; }
  .brand b { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: var(--red); color: #fff; font-weight: 700; }
  nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .side a:not(.brand) { display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 12px; border-radius: 12px; color: var(--muted); font-size: .92rem; font-weight: 500; transition: background .15s, color .15s; }
  .side a:not(.brand):hover { background: var(--soft); color: var(--ink); text-decoration: none; }
  .side a.on { background: var(--red-tint); color: var(--red); }
  .side a:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
  svg { flex: none; }
  .lang b { flex: none; display: grid; place-items: center; width: 22px; font-size: .72rem; font-weight: 700; }
  @media (max-width: 640px) {
    :global(.frame) { flex-direction: column-reverse; }
    .side { width: auto; flex-direction: row; justify-content: space-around; gap: 0; padding: 6px; border-right: 0; border-top: 1px solid var(--line); }
    nav { flex-direction: row; flex: none; gap: 2px; }
    .brand { display: none; }
    .side a:not(.brand) { flex-direction: column; justify-content: center; gap: 2px; height: 48px; padding: 0 10px; font-size: .68rem; }
    .lang b { width: auto; height: 22px; display: grid; align-items: center; }
  }
</style>
