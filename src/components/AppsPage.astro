---
import Base from '../layouts/Base.astro';
import AppIcon from './AppIcon.astro';
import { ui, path, otherLang, type Lang } from '../i18n';
import { apps } from '../data/apps';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].apps;
---
<Base lang={lang} title="Apps" description={t.lead} alt={path(otherLang(lang), 'apps')} alternates={{ es: path('es', 'apps'), en: path('en', 'apps') }}>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="muted">{t.lead}</p>
    </div>
    <div class="app-list" style="padding-bottom:4rem">
      {apps.map((a) => (
        <a class="app-row" href={path(lang, `apps/${a.slug}`)}>
          <AppIcon app={a} size={48} />
          <div class="info">
            <h3>{a.name}</h3>
            <p>{a.description[lang]}</p>
            <div class="tags">{a.tags?.map((x) => <span class="tag">{x}</span>)}</div>
          </div>
          <span class="go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</Base>
