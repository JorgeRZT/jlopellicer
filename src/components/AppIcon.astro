---
import type { App } from '../data/apps';
interface Props { app: App; size?: number }
const { app, size = 44 } = Astro.props;
---
{app.icon
  ? <img class="app-icon" src={app.icon} width={size} height={size} alt="" loading="lazy" style={`width:${size}px;height:${size}px`} />
  : <span class="app-icon tile" aria-hidden="true" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.45)}px`}>{app.name[0]}</span>}
<style is:global>
  .app-icon { flex: none; border-radius: 22%; object-fit: cover; }
  .app-icon.tile { display: grid; place-items: center; background: var(--red); color: #fff; font-weight: 700; }
</style>
