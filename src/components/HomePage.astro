---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui, path, otherLang, type Lang } from '../i18n';
import { contact, content } from '../data/profile';
import { apps } from '../data/apps';
import AppIcon from './AppIcon.astro';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const c = content[lang];
const keys = Object.keys(t.chat.prompts) as (keyof typeof t.chat.prompts)[];
const posts = (await getCollection('blog', (p) => p.id.startsWith(`${lang}/`) && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat(t.dateLocale, { dateStyle: 'long' });
---
<Base lang={lang} alt={path(otherLang(lang))} alternates={{ es: path('es'), en: path('en') }}>
  <div class="chat landing">
    <div class="log" id="log" aria-live="polite">
     <div class="thread" id="thread">
      <div class="msg bot">
        <span class="avatar" aria-hidden="true">J</span>
        <div class="bubble">
          <p class="eyebrow">{c.role}</p>
          <h1>{t.chat.hello} {contact.name}</h1>
          <p class="lead">{c.tagline}</p>
          <p class="muted">{t.chat.hint}</p>
        </div>
      </div>
     </div>
    </div>

    <div class="composer" id="composer">
      <div class="menu" id="menu" role="menu" aria-label={t.chat.menuLabel} hidden>
        {keys.map((k) => <button type="button" role="menuitem" data-key={k}>{t.chat.prompts[k]}</button>)}
      </div>
      <div class="input-wrap">
      <button type="button" class="input" id="input" aria-haspopup="menu" aria-expanded="false" aria-controls="menu">
        <span>{t.chat.placeholder}</span><span class="caret" aria-hidden="true">▲</span>
      </button>
      </div>
    </div>

    <!-- Answers: cloned into the chat on demand. Visible when JS is off. -->
    <div id="sections" hidden>
      <div data-key="about">
        <h2>{t.sections.about}</h2>
        <div class="prose">{c.about.map((x) => <p>{x}</p>)}</div>
      </div>
      <div data-key="experience">
        <h2>{t.sections.experience}</h2>
        <ul class="timeline">
          {c.experience.map((e) => (
            <li>
              <span class="period">{e.period}</span>
              <div>
                <strong>{e.role}</strong>
                <span>{e.company}{e.location && <span class="muted"> · {e.location}</span>}</span>
                {e.text && <span class="muted desc">{e.text}</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div data-key="education">
        <h2>{t.sections.education}</h2>
        <ul class="timeline">
          {c.education.map((e) => (
            <li><span class="period">{e.period}</span><div><strong>{e.title}</strong><span class="muted">{e.place}</span></div></li>
          ))}
        </ul>
      </div>
      <div data-key="certs">
        <h2>{t.sections.certs}</h2>
        <ul class="list">{c.certs.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div data-key="languages">
        <h2>{t.sections.languages}</h2>
        <p>{c.languages.map((l) => <span class="tag">{l.name} · {l.level}</span>)}</p>
      </div>
      <div data-key="skills">
        <h2>{t.sections.skills}</h2>
        <p>{c.skills.map((s) => <span class="tag">{s}</span>)}</p>
      </div>
      <div data-key="apps">
        <h2>{t.apps.title}</h2>
        <div class="app-list">
          {apps.map((a) => (
            <a class="app-row" href={path(lang, `apps/${a.slug}`)}>
          <AppIcon app={a} size={40} />
          <div class="info">
            <h3>{a.name}</h3>
            <p>{a.description[lang]}</p>
            <div class="tags">{a.tags?.map((x) => <span class="tag">{x}</span>)}</div>
          </div>
          <span class="go" aria-hidden="true">→</span>
        </a>
          ))}
        </div>
        <p><a href={path(lang, 'apps')}>{t.chat.allApps}</a></p>
      </div>
      <div data-key="blog">
        <h2>{t.blog.title}</h2>
        {posts.length === 0 && <p class="muted">{t.chat.noPosts}</p>}
        {posts.length > 0 && (
          <ul class="list">
            {posts.slice(0, 5).map((p) => <li><a href={`${path(lang, 'blog')}${p.id.slice(3)}/`}>{p.data.title}</a> <span class="muted">· {fmt.format(p.data.date)}</span></li>)}
          </ul>
        )}
        <p><a href={path(lang, 'blog')}>{t.chat.allPosts}</a></p>
      </div>
      <div data-key="contact">
        <h2>{t.chat.prompts.contact}</h2>
        <p class="cta">
          <a class="btn" href={contact.linkedin} rel="noopener">{t.hero.linkedin}</a>
          <a class="btn" href={`mailto:${contact.email}`}>{t.hero.contact}</a>
        </p>
      </div>
    </div>
  </div>
  <noscript><style>#sections[hidden]{display:block}#composer{display:none}#sections{padding:0 24px 24px;max-width:760px;margin:0 auto}.chat.landing{display:block;overflow:auto}</style></noscript>
</Base>

<style is:global>
  main:has(.chat) { overflow: hidden; }
  .chat { height: 100%; display: flex; flex-direction: column; }
  .chat .log { flex: 1; min-height: 0; overflow-y: auto; padding: 32px 20px 16px; scroll-behavior: smooth; }
  .chat.landing { justify-content: center; }
  .chat.landing .log { flex: none; overflow: visible; padding-bottom: 12px; }
  .chat .thread { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 28px; }
  .chat .msg { display: flex; gap: 14px; }
  .chat .msg.me { justify-content: flex-end; }
  .chat .avatar { flex: none; width: 30px; height: 30px; margin-top: 2px; display: grid; place-items: center; border-radius: 50%; background: var(--red); color: #fff; font-size: .8rem; font-weight: 700; }
  .chat .bubble { min-width: 0; }
  .chat .msg.bot .bubble { flex: 1; }
  .chat .msg.me .bubble { max-width: 80%; padding: .6rem 1.1rem; border-radius: 22px 22px 6px 22px; background: var(--red-tint); color: var(--ink); }
  .chat .bubble h1 { font-size: clamp(1.7rem, 4.5vw, 2.4rem); margin: 0 0 .3em; }
  .chat .bubble h2 { font-size: 1.05rem; margin: 0 0 .7em; }
  .chat .bubble p { margin: 0 0 .7em; }
  .chat .bubble > :last-child { margin-bottom: 0; }
  .chat .bubble .lead { font-size: 1.1rem; }
  .chat .flash .bubble { animation: flash 1.2s ease; }
  @keyframes flash { 0%, 60% { background: var(--red-tint); box-shadow: 0 0 0 8px var(--red-tint); border-radius: 12px; } 100% { background: transparent; box-shadow: none; } }
  .chat .typing span { display: inline-block; width: 7px; height: 7px; margin: 8px 3px 0 0; border-radius: 50%; background: var(--red); animation: blink 1s infinite; }
  .chat .typing span:nth-child(2) { animation-delay: .2s; }
  .chat .typing span:nth-child(3) { animation-delay: .4s; }
  .chat .tw-hide { display: none !important; }
  .chat .tw-caret { display: inline-block; width: 2px; height: 1.05em; margin-left: 2px; vertical-align: -.15em; background: var(--red); animation: caret .8s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  @keyframes blink { 0%, 60%, 100% { opacity: .2; } 30% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .chat .log { scroll-behavior: auto; } .chat .typing span, .chat .flash .bubble, .chat .input-wrap, .chat .tw-caret { animation: none; } }

  .chat .composer { position: relative; flex: none; width: 100%; max-width: 780px; margin: 0 auto; padding: 8px 20px 4px; }
  @property --angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  .chat .input-wrap { --rainbow: conic-gradient(from var(--angle), #ff3b30, #ff9500, #ffd60a, #34c759, #00c7be, #0a84ff, #bf5af2, #ff2d92, #ff3b30); position: relative; animation: spin 5s linear infinite; }
  .chat .input-wrap::before { content: ''; position: absolute; inset: 2px; border-radius: 999px; background: var(--rainbow); filter: blur(14px); opacity: .35; transition: opacity .2s; }
  .chat .input-wrap:hover::before, .chat .input-wrap:has([aria-expanded='true'])::before { opacity: .6; }
  .chat .input-wrap:has([aria-expanded='true']) { animation-duration: 2.5s; }
  @keyframes spin { to { --angle: 360deg; } }
  .chat .input { position: relative; width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 13px 13px 13px 22px; font: inherit; text-align: left; color: var(--muted); border: 2px solid transparent; border-radius: 999px; cursor: text; background: linear-gradient(var(--surface), var(--surface)) padding-box, var(--rainbow) border-box; }
  .chat .input:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .chat .caret { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--red); color: #fff; font-size: .7rem; transition: transform .2s; }
  .chat .input[aria-expanded='true'] .caret { transform: rotate(180deg); }
  .chat .menu { position: absolute; left: 20px; right: 20px; bottom: calc(100% - 2px); max-height: min(60vh, 440px); overflow-y: auto; padding: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--shadow); z-index: 5; }
  .chat .menu[hidden] { display: none; }
  .chat .menu button { display: block; width: 100%; padding: .6rem .9rem; font: inherit; text-align: left; background: none; border: 0; border-radius: 12px; color: var(--ink); cursor: pointer; }
  .chat .menu button:hover, .chat .menu button:focus-visible { background: var(--red-tint); color: var(--red); outline: 0; }
  .chat .menu button[data-done]::after { content: ' ✓'; color: var(--muted); }
  @media (max-width: 600px) { .chat .log { padding: 20px 14px 10px; } .chat .composer { padding: 8px 12px 2px; } .chat .menu { left: 12px; right: 12px; } .chat .msg { gap: 10px; } }
</style>

<script>
  const log = document.getElementById('log')!;
  const thread = document.getElementById('thread')!;
  const input = document.getElementById('input')!;
  const menu = document.getElementById('menu')!;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const shown = new Map<string, HTMLElement>();

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    input.setAttribute('aria-expanded', String(open));
    if (open) (menu.querySelector('button') as HTMLElement)?.focus({ preventScroll: true });
  };
  const toEnd = () => log.scrollTo({ top: log.scrollHeight, behavior: calm ? 'auto' : 'smooth' });
  const el = (html: string) => {
    const d = document.createElement('div');
    d.innerHTML = html;
    return d.firstElementChild as HTMLElement;
  };

  const chat = document.querySelector('.chat')!;
  const composer = document.getElementById('composer')!;

  // First interaction: the composer glides from the centre of the page to the bottom.
  const dock = (then: () => void) => {
    if (!chat.classList.contains('landing')) return then();
    const movers = [composer, thread.firstElementChild as HTMLElement];
    const before = movers.map((m) => m.getBoundingClientRect().top);
    chat.classList.remove('landing');
    if (calm) return then();
    movers.forEach((m, i) => {
      m.style.transition = 'none';
      m.style.transform = `translateY(${before[i] - m.getBoundingClientRect().top}px)`;
    });
    void chat.getBoundingClientRect();
    movers.forEach((m) => {
      m.style.transition = 'transform .55s cubic-bezier(.2, .8, .2, 1)';
      m.style.transform = '';
    });
    setTimeout(() => { movers.forEach((m) => (m.style.transition = '')); then(); }, 450);
  };

  let skip: (() => void) | null = null;

  // Types the answer character by character, keeping its structure (lists, tags, links) intact.
  const typeInto = (root: HTMLElement, reply: HTMLElement, me: HTMLElement) => {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const items: { node: Text; full: string }[] = [];
    for (let n = walker.nextNode() as Text | null; n; n = walker.nextNode() as Text | null) {
      if (n.data.trim() && !n.parentElement?.closest('[aria-hidden="true"]')) items.push({ node: n, full: n.data });
    }
    const total = items.reduce((sum, i) => sum + i.full.length, 0);
    if (!total) return;

    // Only elements that wrap typed text are hidden; icons and decorations stay visible.
    const all = [...root.querySelectorAll<HTMLElement>('*')].filter((e) => items.some((i) => e.contains(i.node)));
    all.forEach((e) => e.classList.add('tw-hide'));
    items.forEach((i) => (i.node.data = ''));

    const caret = document.createElement('span');
    caret.className = 'tw-caret';
    const rate = Math.max(0.7, total / 240); // chars per frame: ~40/s, capped at ~4 s
    let idx = 0, pos = 0, raf = 0, follow = true, acc = 0;
    const stopFollowing = () => (follow = false);
    log.addEventListener('wheel', stopFollowing, { once: true });
    log.addEventListener('touchstart', stopFollowing, { once: true });

    const finish = () => {
      cancelAnimationFrame(raf);
      items.forEach((i) => (i.node.data = i.full));
      all.forEach((e) => e.classList.remove('tw-hide'));
      caret.remove();
      reply.removeEventListener('click', finish);
      log.removeAttribute('aria-busy');
      skip = null;
    };
    log.setAttribute('aria-busy', 'true');
    reply.addEventListener('click', finish);
    skip = finish;

    const step = () => {
      const it = items[idx];
      if (pos === 0 && acc + rate >= 1) for (let e = it.node.parentElement; e && e !== root; e = e.parentElement) e.classList.remove('tw-hide');
      acc += rate;
      const n = Math.floor(acc);
      acc -= n;
      if (n > 0) {
        pos = Math.min(it.full.length, pos + n);
        it.node.data = it.full.slice(0, pos);
        it.node.after(caret);
        if (pos >= it.full.length) { idx++; pos = 0; }
      }

      if (follow) {
        const gap = reply.getBoundingClientRect().bottom - log.getBoundingClientRect().bottom + 24;
        const room = me.getBoundingClientRect().top - log.getBoundingClientRect().top - 8;
        if (gap > 0 && room > 0) log.scrollBy({ top: Math.min(gap, room), behavior: 'instant' });
      }
      if (idx >= items.length) return finish();
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  };

  input.addEventListener('click', () => {
    if (chat.classList.contains('landing')) dock(() => setOpen(true));
    else setOpen(menu.hidden);
  });
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !(e.target as Element).closest('#composer')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); input.focus(); }
  });
  menu.addEventListener('keydown', (e) => {
    const items = [...menu.querySelectorAll('button')];
    const i = items.indexOf(document.activeElement as HTMLButtonElement);
    if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
  });

  menu.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('button');
    if (!btn) return;
    const key = btn.dataset.key!;
    setOpen(false);
    input.focus({ preventScroll: true });

    const existing = shown.get(key);
    if (existing) {
      existing.scrollIntoView({ block: 'start', behavior: calm ? 'auto' : 'smooth' });
      existing.classList.add('flash');
      setTimeout(() => existing.classList.remove('flash'), 1200);
      return;
    }
    btn.dataset.done = '';

    const me = el('<div class="msg me"><div class="bubble"></div></div>');
    me.querySelector('.bubble')!.textContent = btn.textContent;
    thread.append(me);

    const reply = el('<div class="msg bot"><span class="avatar" aria-hidden="true">J</span><div class="bubble"><span class="typing"><span></span><span></span><span></span></span></div></div>');
    thread.append(reply);
    toEnd();

    const source = document.querySelector(`#sections [data-key="${key}"]`)!;
    skip?.();
    setTimeout(() => {
      const bubble = reply.querySelector('.bubble') as HTMLElement;
      bubble.replaceChildren(...[...source.cloneNode(true).childNodes]);
      shown.set(key, reply);
      me.scrollIntoView({ block: 'start', behavior: calm ? 'auto' : 'smooth' });
      if (!calm) typeInto(bubble, reply, me);
    }, calm ? 0 : 500);
  });
</script>
