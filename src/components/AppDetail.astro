---
import Base from '../layouts/Base.astro';
import AppIcon from './AppIcon.astro';
import { ui, path, otherLang, type Lang } from '../i18n';
import { latestDownload, type App } from '../data/apps';
const { lang, app } = Astro.props as { lang: Lang; app: App };
const t = ui[lang].apps;
const dl = await latestDownload(app);
const here = path(lang, `apps/${app.slug}`);
const there = path(otherLang(lang), `apps/${app.slug}`);
const repoUrl = `https://github.com/${app.repo}`;
---
<Base lang={lang} title={app.name} description={app.description[lang]} alt={there} alternates={{ [lang]: here, [otherLang(lang)]: there }}>
  <div class="wrap">
    <article class="detail">
      <a class="back" href={path(lang, 'apps')}>{t.back}</a>
      <header class="head">
        <AppIcon app={app} size={72} />
        <div>
          <h1>{app.name}</h1>
          <p class="muted">{app.description[lang]}</p>
        </div>
      </header>

      <p class="cta">
        {dl && <a class="btn" href={dl.url} download>⬇ {t.download} <small>{dl.version}</small></a>}
        {app.live && <a class="btn" href={app.live} target="_blank" rel="noopener">{t.open} ↗</a>}
        <a class="btn ghost" href={repoUrl} target="_blank" rel="noopener">{t.repo} ↗</a>
      </p>

      <h2>{t.features}</h2>
      <ul class="list">{app.features[lang].map((f) => <li>{f}</li>)}</ul>

      {app.screenshots && (
        <>
          <h2>{t.screenshots}</h2>
          <div class="shots">
            {app.screenshots.map((x) => (
              <button type="button" class="shot" data-src={x.src} data-alt={x.alt[lang]}><img src={x.src} alt={x.alt[lang]} loading="lazy" width="1120" height="800" /></button>
            ))}
          </div>
        </>
      )}

      <p class="meta">
        {app.platform && <span class="tag">{t.platform}: {app.platform[lang]}</span>}
        {app.tags?.map((x) => <span class="tag">{x}</span>)}
      </p>
      {app.note && <p class="muted note">{app.note[lang]}</p>}
    </article>
  </div>
  <dialog id="lightbox" aria-label={t.screenshots}>
    <button type="button" class="close" aria-label="Close">×</button>
    <img alt="" />
  </dialog>
</Base>
<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement | null;
  const big = box?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('.shot').forEach((b) => b.addEventListener('click', () => {
    if (!box || !big) return;
    big.src = b.dataset.src!;
    big.alt = b.dataset.alt!;
    box.showModal();
  }));
  box?.addEventListener('click', () => box.close());
</script>
<style>
  .detail { padding: 2.5rem 0 4rem; max-width: 680px; }
  .back { font-size: .9rem; color: var(--muted); }
  .back:hover { color: var(--red); }
  .head { display: flex; gap: 1.2rem; align-items: center; margin: 1.5rem 0 1.5rem; }
  .head h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); margin: 0 0 .2em; }
  .head p { margin: 0; }
  .cta { margin: 0 0 2rem; }
  .btn small { opacity: .8; font-weight: 500; margin-left: .25rem; }
  h2 { margin-top: 0; }
  .shots { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; margin-top: 1rem; }
  .shot { padding: 0; border: 0; background: none; cursor: zoom-in; }
  .shots img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--border, rgba(128,128,128,.25)); display: block; }
  @media (max-width: 560px) { .shots { grid-template-columns: 1fr; } }
  .meta { margin: 1.5rem 0 0; }
  .meta .tag:first-child { margin-left: 0; }
  .note { font-size: .9rem; margin-top: 1.5rem; padding-left: .9rem; border-left: 3px solid var(--red-tint); }
</style>
<style is:global>
  #lightbox { max-width: 96vw; max-height: 96dvh; padding: 0; border: 0; background: transparent; overflow: visible; }
  #lightbox::backdrop { background: rgba(0, 0, 0, .8); }
  #lightbox img { display: block; max-width: 96vw; max-height: 92dvh; border-radius: 10px; }
  #lightbox .close { position: absolute; top: -14px; right: -6px; width: 34px; height: 34px; border-radius: 50%; border: 0; background: var(--red); color: #fff; font-size: 1.3rem; line-height: 1; cursor: pointer; }
</style>
